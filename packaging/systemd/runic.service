[Unit]
Description=runic — local SOCKS5 to upstream HTTP CONNECT proxy
After=network-online.target
Wants=network-online.target

[Service]
# notify: "active" = the SOCKS5 surface is really bound (runic sends READY=1
# via sd_notify) and systemctl status shows a live "Status:" line with both
# the SOCKS5 and admin endpoints — the discovery entry point in auto-port mode.
Type=notify
ExecStart=%h/.local/bin/runic --config %h/.config/runic/runic.yaml
# Optional (leading "-"): only needed when the YAML references *_env
# credentials. A config with no creds at all (e.g. fully API-driven) must
# still be able to start.
EnvironmentFile=-%h/.config/runic/creds.env
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
