# runic config — copy this to %APPDATA%\runic\runic.yaml and edit.
#
# The tray reads %APPDATA%\runic\runic.yaml (NOT this file next to the exe).
#
# Every key below is commented out: each shows its BUILT-IN DEFAULT, which
# applies as long as the key stays commented. Uncomment only what you change —
# an entirely commented file is a valid config. An empty upstream pool is
# valid too: runic boots and declines sessions until an upstream is pushed
# over the admin API. See the project docs for the full reference.

# SOCKS5 data plane your apps point at — loopback only (no auth): the bind
# address is the trust boundary, do not expose it off-host. Port 0 (the
# default) = auto mode: the OS picks a free port; read the real one from
# GET /v1/status (`listen`) on the fixed admin port. For a stable port,
# uncomment addr with an explicit port (e.g. "127.0.0.1:7878"), or keep
# port 0 and set port_range to scan a window — first free port wins.
# listen:
#   addr: "127.0.0.1:0"
#   port_range: "20000-20100"   # optional; only with port 0 (no built-in default)
#   auth: none

# Admin API + status page (http://127.0.0.1:48484/), loopback only.
# admin:
#   addr: "127.0.0.1:48484"

# Named upstream pool — empty by default. Clients always hit the same loopback
# endpoint above; runic decides which upstream the traffic exits through.
# upstreams:
#   default:
#     kind: http_connect
#     host: gw.example-provider.com
#     port: 823
#     auth:
#       username_env: RUNIC_UPSTREAM_USER   # creds come from the environment
#       password_env: RUNIC_UPSTREAM_PASS   # (user env vars), never the file
