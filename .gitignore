/target
# Standalone sibling crate (not a workspace member) — its build dir lives here.
/runic-tray/target
# Packaged release artifacts (built by packaging/windows/package.ps1).
/dist
# Local build tools fetched on the box (e.g. WiX v3 binaries for the MSI) — not vendored.
/.tools
Cargo.lock.bak
*.swp
.DS_Store

# Claude Code local-only settings (per repo convention)
.claude/settings.local.json

# Local-only secrets / config overrides (V0 expects env-injected creds, never commit real ones)
.env
.env.local

# Internal working dir (notes, prior-art scans, bug files) — never pushed to the
# public repo: may reference private tracker tickets / internal context.
/dev

# Local MCP server config (references internal tooling — not for the public repo)
.mcp.json
